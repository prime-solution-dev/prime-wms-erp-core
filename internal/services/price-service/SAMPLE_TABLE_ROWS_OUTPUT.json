  "usage_example": {
    "description": "How to render this in frontend",
    "pseudocode": [
      "// Get table structure",
      "tableStructure = data[0] // For first PRODUCT_GROUP2",
      "",
      "// Create column headers",
      "headers = ['Product Group 6', 'Product Group 3']",
      "headers.push(...tableStructure.unique_group_5_values)",
      "",
      "// Create table rows",
      "tableStructure.rows.forEach(row => {",
      "  rowData = [row.product_group_6, row.product_group_3]",
      "  ",
      "  // Add column values for each GROUP_5",
      "  tableStructure.unique_group_5_values.forEach(group5 => {",
      "    if (row.columns[group5]) {",
      "      rowData.push(row.columns[group5].price_unit)",
      "    } else {",
      "      rowData.push('-') // Empty cell",
      "    }",
      "  })",
      "  ",
      "  renderTableRow(rowData)",
      "})"
    ]
  }
