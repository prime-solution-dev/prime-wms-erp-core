pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'MIGRATE',
            choices: ['auto', 'force', 'skip'],
            description: 'auto = รันเมื่อ migrations เปลี่ยน, force = รันแน่นอน, skip = ไม่รัน'
        )
        choice(
            name: 'SEED',
            choices: ['auto', 'force', 'skip'],
            description: 'auto = รันเมื่อ seeds เปลี่ยน, force = รันแน่นอน, skip = ไม่รัน'
        )
        string(
            name: 'SEED_SET',
            defaultValue: '',
            description: 'ชื่อ Folder ใต้ seeds/ ว่าง = master; ใช้ dev เมื่อต้องการ Seed สำหรับ Dev'
        )
    }

    environment {
        REPO_NAME = 'prime-wms-document-core'        
        IMAGE_NAME = 'wms-document-core'
        PORT = '9106:9106'  
        CONTAINER_NAME = 'wms-reports-core-container'
        TARGET_BRANCH = 'Develop'
        VAULT_PATH = 'JenkinsWMS/jenkins.developWMS'
        ENV_FILE_KEY = 'Develop.env.erp' 
        BACKUP_DIR = '/wms/backup_wms'
        MIGRATION_CONTAINER = 'pipeline-migration'
        DEPLOY_STATE_DIR = '/var/lib/jenkins/deploy-state'
        RUN_MIGRATE = 'false'
        RUN_SEED = 'false'
        RECORD_COMMIT = 'false'
        DEPLOY_STARTED = 'false'
        DEPLOY_SUCCEEDED = 'false'
        BACKUP_CREATED = 'false'
    }
stages {
stage('Clone Repository') {
    steps {
        script {
            echo "Checking out branch ${TARGET_BRANCH} on Jenkins..."

            deleteDir()

            checkout([
                $class: 'GitSCM',
                branches: [[
                    name: "*/${TARGET_BRANCH}"
                ]],
                userRemoteConfigs: [[
                    url: "https://github.com/prime-solution-dev/${REPO_NAME}.git",
                    credentialsId: 'git_token_deploy'
                ]],
                extensions: [[
                    $class: 'CloneOption',
                    shallow: false,
                    noTags: false
                ]]
            ])

            echo 'Repository checked out successfully on Jenkins!'
        }
    }
}

        stage('Check GitHub Changes') {
            steps {
                script {
                    def migrateMode = params.MIGRATE ?: 'auto'
                    def seedMode = params.SEED ?: 'auto'
                    env.SEED_DIR = params.SEED_SET?.trim()
                        ? params.SEED_SET.trim()
                        : 'master'

                    if (!(env.SEED_DIR ==~ /^[A-Za-z0-9_-]+$/)) {
                        error("SEED_SET must be a safe folder name: ${env.SEED_DIR}")
                    }
                    if (!fileExists("seeds/${env.SEED_DIR}")) {
                        error("Seed folder does not exist: seeds/${env.SEED_DIR}")
                    }

                    env.STATE_KEY = env.JOB_NAME.replaceAll('[^A-Za-z0-9_.-]', '_')
                    env.DEPLOY_COMMIT = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    def stateFile = "${env.DEPLOY_STATE_DIR}/${env.STATE_KEY}.commit"
                    def previousCommit = sh(
                        script: "test -s '${stateFile}' && cat '${stateFile}' || true",
                        returnStdout: true
                    ).trim()

                    if (previousCommit && !(previousCommit ==~ /^[0-9a-fA-F]{7,40}$/)) {
                        error("Invalid stored deployed commit: ${previousCommit}")
                    }

                    def firstDeploy = !previousCommit
                    def previousAvailable = previousCommit && sh(
                        script: "git cat-file -e '${previousCommit}^{commit}'",
                        returnStatus: true
                    ) == 0

                    def migrationsChanged = firstDeploy || !previousAvailable ||
                        sh(
                            script: "git diff --quiet '${previousCommit}' HEAD -- migrations/",
                            returnStatus: true
                        ) != 0

                    def seedsChanged = firstDeploy || !previousAvailable ||
                        sh(
                            script: "git diff --quiet '${previousCommit}' HEAD -- seeds/${env.SEED_DIR}/",
                            returnStatus: true
                        ) != 0

                    // Explicitly selected seed sets are treated as changed in auto mode.
                    if (params.SEED_SET?.trim() && seedMode == 'auto') {
                        seedsChanged = true
                    }

                    env.RUN_MIGRATE = (
                        migrateMode == 'force' ||
                        (migrateMode == 'auto' && migrationsChanged)
                    ).toString()
                    env.RUN_SEED = (
                        seedMode == 'force' ||
                        (seedMode == 'auto' && seedsChanged)
                    ).toString()

                    env.RECORD_COMMIT = (
                        !(migrateMode == 'skip' && migrationsChanged) &&
                        !(seedMode == 'skip' && seedsChanged)
                    ).toString()

                    echo "MIGRATE=${migrateMode} changed=${migrationsChanged} run=${env.RUN_MIGRATE}"
                    echo "SEED=${seedMode} set=${env.SEED_DIR} changed=${seedsChanged} run=${env.RUN_SEED}"
                    echo "Previous deployed commit: ${previousCommit ?: '(none)'}"
                    echo "Current commit: ${env.DEPLOY_COMMIT}"
                }
            }
        }

        stage('Check Workspace') {
            steps {
                script {
                    sh 'pwd'
                }
            }
        }

       stage('Fetch .env from Vault') {
    steps {
        script {
            echo "Fetching .env from Vault..."

            withVault([vaultSecrets: [
                [
                    path: "${VAULT_PATH}",
                    engineVersion: 2,
                    secretValues: [
                        [
                            envVar: 'AUTHEN_ENV',
                            vaultKey: "${ENV_FILE_KEY}"
                        ]
                    ]
                ]
            ]]) {
                sh '''
                    mkdir -p cmd
                    printf "%s" "$AUTHEN_ENV" > cmd/.env
                    chmod 600 cmd/.env
                    echo ".env written to cmd/.env"
                '''
            }
        }
    }
}

        stage('Backup Current Image') {
            steps {
                script {
                    def timestamp = new Date().format("yyyyMMdd-HHmmss", TimeZone.getTimeZone('UTC'))
                    env.BACKUP_IMAGE = "${IMAGE_NAME}-backup:${timestamp}-${BUILD_NUMBER}"
                    env.BACKUP_ARCHIVE = "${BACKUP_DIR}/${IMAGE_NAME}-backup-${timestamp}-${BUILD_NUMBER}.tar"

                    echo 'Backing up current image...'
                    def sourceImage = sh(
                        script: "docker images --filter=reference='${IMAGE_NAME}:latest' -q",
                        returnStdout: true
                    ).trim()

                    if (sourceImage) {
                        sh """
                            set -eu
                            mkdir -p '${BACKUP_DIR}'
                            docker tag '${IMAGE_NAME}:latest' '${BACKUP_IMAGE}'
                            docker save -o '${BACKUP_ARCHIVE}' '${BACKUP_IMAGE}'
                            test -s '${BACKUP_ARCHIVE}'
                        """
                        env.BACKUP_CREATED = 'true'
                        echo "Backup created: ${BACKUP_IMAGE}"
                        echo "Image exported to ${BACKUP_ARCHIVE}"
                    } else {
                        echo 'No source image found, skipping backup.'
                    }

                    echo 'Cleaning up old backup images...'
                    def backupImages = sh(
                        script: "docker images --filter=reference='${IMAGE_NAME}-backup:*' --format '{{.Repository}}:{{.Tag}}' | sort -r | tail -n +6",
                        returnStdout: true
                    ).trim()

                    if (backupImages) {
                        sh "printf '%s\\n' '${backupImages}' | xargs -r docker rmi -f"
                        echo 'Old backups removed.'
                    } else {
                        echo 'No old backups to remove.'
                    }

                    echo 'Cleaning up old backup archives...'
                    sh """
                        find '${BACKUP_DIR}' -maxdepth 1 -type f \\
                            -name '${IMAGE_NAME}-backup-*.tar' -printf '%T@ %p\\n' |
                            sort -rn | tail -n +6 | cut -d' ' -f2- | xargs -r rm -f
                    """
                }
            }
        }

        stage('Build Docker Image') {
    steps {
        script {
            sh '''
                set -e

                BUILD_DIR="/tmp/${JOB_NAME}-${BUILD_NUMBER}-build"

                rm -rf "$BUILD_DIR"
                mkdir -p "$BUILD_DIR"
                cleanup() { rm -rf "$BUILD_DIR"; }
                trap cleanup EXIT

                cp -a . "$BUILD_DIR/"
                cd "$BUILD_DIR"

                echo "========================================="
                echo "Create Service-X Stub"
                echo "========================================="

                mkdir -p stubs/prime-service-x/servicelog

                cat > stubs/prime-service-x/go.mod <<'EOF'
module github.com/prime-solution-dev/prime-service-x

go 1.25
EOF

                cat > stubs/prime-service-x/servicelog/servicelog.go <<'EOF'
package servicelog

import "context"

type Config struct {
    Enabled     bool
    ServiceName string
}

type ServiceLog struct {
    ID        string
    TraceID   string
    RequestID string
    Service   string
    BaseURL   string
    Endpoint  string
    Method    string
    Request   interface{}
    User      string
}

func LoadFromEnv() Config {
    return Config{
        Enabled: false,
    }
}

func Init(cfg Config) error {
    return nil
}

func Create(ctx context.Context, log ServiceLog) error {
    return nil
}

func Update(
    ctx context.Context,
    requestID string,
    response interface{},
    httpStatus int,
    status string,
    errorMessage string,
    durationMs int64,
) error {
    return nil
}
EOF

                echo "========================================="
                echo "Replace Service-X with local stub"
                echo "========================================="

                go mod edit \
                    -replace=github.com/prime-solution-dev/prime-service-x=./stubs/prime-service-x

                echo "========================================="
                echo "Patch temporary Dockerfile"
                echo "========================================="

                sed -i '/COPY go.mod go.sum .\\//a COPY stubs/prime-service-x ./stubs/prime-service-x' Dockerfile

                echo "=== Temporary Dockerfile ==="
                cat Dockerfile

                echo "========================================="
                echo "Build ${IMAGE_NAME}:latest"
                echo "========================================="

                docker build \
                    --no-cache \
                    -t ${IMAGE_NAME}:latest \
                    .
                
                echo "=== Verify built image ==="
docker image ls --filter "reference=${IMAGE_NAME}:latest"
docker image inspect "${IMAGE_NAME}:latest"

echo "=== Build verified successfully ==="

            '''
        }
            }
        }

        stage('Ensure Go Migration Container') {
            when {
                expression { env.RUN_MIGRATE == 'true' || env.RUN_SEED == 'true' }
            }
            steps {
                sh '''
                    set -eu

                    if ! docker container inspect "$MIGRATION_CONTAINER" >/dev/null 2>&1; then
                        docker create \
                            --name "$MIGRATION_CONTAINER" \
                            --network host \
                            -e 'GOPRIVATE=github.com/prime-solution-dev/*' \
                            -v "$PWD:/src" \
                            -w /src \
                            golang:1.25 \
                            tail -f /dev/null >/dev/null
                    fi

                    if [ "$(docker inspect --format '{{.State.Running}}' "$MIGRATION_CONTAINER")" != 'true' ]; then
                        docker start "$MIGRATION_CONTAINER" >/dev/null
                    fi
                '''
            }
        }

        stage('Run Database Migrations') {
            when {
                expression { env.RUN_MIGRATE == 'true' }
            }
            steps {
                script {
                    echo 'Running schema migrations before replacing the container...'
                    withVault([vaultSecrets: [[
                        path: "${VAULT_PATH}",
                        engineVersion: 2,
                        secretValues: [[envVar: 'MIGRATION_ENV', vaultKey: "${ENV_FILE_KEY}"]]
                    ]]]) {
                        withCredentials([string(credentialsId: 'GITTOKEN', variable: 'GIT_TOKEN')]) {
                            sh '''
                                set +x
                                set -eu
                                printf '%s\n' "$MIGRATION_ENV" > .env
                                chmod 600 .env
                                trap 'rm -f .env' EXIT

                                docker exec -e GIT_TOKEN "$MIGRATION_CONTAINER" sh -ec '
                                    set -eu
                                    umask 077
                                    printf "machine github.com\\nlogin x-access-token\\npassword %s\\n" \
                                        "$GIT_TOKEN" > /root/.netrc
                                    trap "rm -f /root/.netrc" EXIT
                                    go run ./cmd/migrate -command up
                                '
                            '''
                        }
                    }
                }
            }
        }

        stage('Run Database Seeds') {
            when {
                expression { env.RUN_SEED == 'true' }
            }
            steps {
                script {
                    echo "Running seeds/${env.SEED_DIR} before replacing the container..."
                    withVault([vaultSecrets: [[
                        path: "${VAULT_PATH}",
                        engineVersion: 2,
                        secretValues: [[envVar: 'SEED_ENV', vaultKey: "${ENV_FILE_KEY}"]]
                    ]]]) {
                        withCredentials([string(credentialsId: 'GITTOKEN', variable: 'GIT_TOKEN')]) {
                            sh '''
                                set +x
                                set -eu
                                printf '%s\n' "$SEED_ENV" > .env
                                chmod 600 .env
                                trap 'rm -f .env' EXIT

                                docker exec \
                                    -e GIT_TOKEN \
                                    -e "SEED_DIR=$SEED_DIR" \
                                    "$MIGRATION_CONTAINER" sh -ec '
                                        set -eu
                                        umask 077
                                        printf "machine github.com\\nlogin x-access-token\\npassword %s\\n" \
                                            "$GIT_TOKEN" > /root/.netrc
                                        trap "rm -f /root/.netrc" EXIT
                                        go run ./cmd/migrate -set "$SEED_DIR" -command up
                                    '
                            '''
                        }
                    }
                }
            }
        }

        stage('Stop and Remove Old Container') {
            steps {
                script {
                    echo 'Stopping and removing old container...'
                    // Do not rollback or stop the current container when an earlier stage fails.
                    env.DEPLOY_STARTED = 'true'
                    def containerExists = sh(
                        script: 'docker inspect -q "$CONTAINER_NAME" 2>/dev/null || true',
                        returnStdout: true
                    ).trim()

                    if (containerExists) {
                        // Replacement is allowed only after backup, build and migrations passed.
                        // -f also removes a stopped container that still reserves the name.
                        sh '''
                            set -eu
                            docker rm -f "$CONTAINER_NAME"
                            if docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
                                echo "ERROR: failed to remove $CONTAINER_NAME"
                                exit 1
                            fi
                        '''
                        echo "Old container stopped and removed."
                    } else {
                        echo "No old container found, skipping stop and remove."
                    }
                }
            }
        }

        stage('Deploy Container') {
            steps {
                script {
                    echo 'Deploying container...'
                    sh '''
                        set -eu

                        # The backup, build and migration stages have already passed.
                        # Remove any stale container name left by an interrupted stop.
                        if docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
                            docker rm -f "$CONTAINER_NAME"
                        fi

                        docker run -d \
                            -p "$PORT" \
                            --name "$CONTAINER_NAME" \
                            --memory=2g \
                            --memory-swap=2g \
                            --cpus=1 \
                            "$IMAGE_NAME:latest"

                        test "$(docker inspect --format '{{.State.Running}}' "$CONTAINER_NAME")" = 'true'
                    '''
                    env.DEPLOY_SUCCEEDED = 'true'
                    echo 'Container deployed successfully!'
                }
            }
        }

        stage('Record Deployed Commit') {
            steps {
                script {
                    if (env.RECORD_COMMIT == 'true') {
                        sh '''
                            set -eu
                            mkdir -p "$DEPLOY_STATE_DIR"
                            printf '%s\n' "$DEPLOY_COMMIT" > \
                                "$DEPLOY_STATE_DIR/$STATE_KEY.commit"
                        '''
                    } else {
                        echo 'Migration or seed changes were skipped; deployed commit was not recorded.'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            script {
                echo 'Pipeline failed. Attempting rollback...'
                if (env.DEPLOY_STARTED != 'true') {
                    echo 'Failure happened before container replacement; leaving the current container untouched.'
                } else if (env.BACKUP_CREATED != 'true') {
                    echo 'No backup was created for this build. Manual recovery may be required.'
                } else {
                    echo "Restoring backup image: ${env.BACKUP_IMAGE}"
                    sh """
                        if docker container inspect '${CONTAINER_NAME}' >/dev/null 2>&1; then
                            docker rm -f '${CONTAINER_NAME}'
                        fi
                        docker run -d \\
                            -p '${PORT}' \\
                            --name '${CONTAINER_NAME}' \\
                            --memory=2g \\
                            --memory-swap=2g \\
                            --cpus=1 \\
                            '${BACKUP_IMAGE}'
                        test \"\$(docker inspect --format '{{.State.Running}}' '${CONTAINER_NAME}')\" = 'true'
                    """
                    echo "Rollback completed using ${env.BACKUP_IMAGE}"
                }
            }
        }
    }
}
