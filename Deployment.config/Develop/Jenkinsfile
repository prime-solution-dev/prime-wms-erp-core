pipeline {
    agent any
    environment {
        REPO_NAME = 'prime-wms-document-core'        
        IMAGE_NAME = 'wms-document-core'
        PORT = '9106:9106'  
        CONTAINER_NAME = 'wms-reports-core-container'
        TARGET_BRANCH = 'Develop'
        VAULT_PATH = 'JenkinsWMS/jenkins.developWMS'
        ENV_FILE_KEY = 'Develop.env.erp' 
    }
stages {
stage('Clone Repository') {
    steps {
        script {
            echo "Cloning repository branch: ${TARGET_BRANCH} on remote server..."

            withCredentials([
                string(credentialsId: 'GITTOKEN', variable: 'GIT_TOKEN')
            ]) {
                sh '''
                    set +x
                    set -e

                    ssh -o StrictHostKeyChecking=no \
                        -i "$SSH_KEY_PATH" \
                        "$REMOTE_USER@$REMOTE_HOST" \
                        "
                        if [ -d '$REPO_NAME/.git' ]; then
                            cd '$REPO_NAME'
                            git fetch origin '$TARGET_BRANCH'
                            git checkout '$TARGET_BRANCH'
                            git reset --hard 'origin/$TARGET_BRANCH'
                        else
                            git clone --depth 1 \
                                -b '$TARGET_BRANCH' \
                                'https://x-access-token:${GIT_TOKEN}@github.com/prime-solution-dev/${REPO_NAME}.git' \
                                '$REPO_NAME'
                        fi
                        "
                '''
            }

            echo 'Repository cloned/updated successfully!'
        }
    }
}

        stage('Check Workspace') {
            steps {
                script {
                    sh 'pwd'
                }
            }
        }

        stage('Git Update') {
            steps {
                script {
                    echo 'Checking out and pulling the latest code...'
                    sh "git checkout ${BRANCH}"
                    sh "git pull origin ${BRANCH}"
                    echo 'Code updated successfully!'
                }
            }
        }
        stage('Fetch .env from Vault') {
    steps {
        script {
            echo "Fetching .env from Vault..."

            withVault([vaultSecrets: [
                [
                    path: "${VAULT_PATH}",
                    engineVersion: 2,
                    secretValues: [
                        [
                            envVar: 'AUTHEN_ENV',
                            vaultKey: "${ENV_FILE_KEY}"
                        ]
                    ]
                ]
            ]]) {
                sh '''
                    mkdir -p cmd
                    printf "%s" "$AUTHEN_ENV" > cmd/.env
                    chmod 600 cmd/.env
                    echo ".env written to cmd/.env"
                '''
            }
        }
    }
}
        
        stage('Backup Current Image') {
            steps {
                script {
                    def timestamp       = new Date().format("yyyyMMdd-HHmmss", TimeZone.getTimeZone('UTC'))
                    def backupImageName = "${IMAGE_NAME}-backup:${timestamp}"
                    def exportPath      = "/wms/backup_wms/${IMAGE_NAME}-backup-${timestamp}.tar"

                    echo 'Backing up current image...'
                    def sourceImage = sh(
                        script: "docker images --filter=reference='${IMAGE_NAME}:latest' -q",
                        returnStdout: true
                    ).trim()

                    if (sourceImage) {
                        sh "docker tag ${IMAGE_NAME}:latest ${backupImageName}"
                        echo "Backup created: ${backupImageName}"

                        echo "Exporting image to ${exportPath}..."
                        sh "docker save -o ${exportPath} ${backupImageName}"
                        echo "Image exported to ${exportPath}"
                    } else {
                        echo 'No source image found, skipping backup.'
                    }

                    echo 'Cleaning up old backups...'
                    def backupImages = sh(
                        script: "docker images --filter=reference='${IMAGE_NAME}-backup:*' --format '{{.Repository}}:{{.Tag}}' | sort | head -n -5",
                        returnStdout: true
                    ).trim()

                    if (backupImages) {
                        sh "echo '${backupImages}' | xargs -r docker rmi -f"
                        echo 'Old backups removed.'
                    } else {
                        echo 'No old backups to remove.'
                    }
                }
            }
        }

        stage('Remove Old Docker Image') {
            steps {
                script {
                    echo 'Removing old Docker image...'
                    sh "docker rmi -f ${IMAGE_NAME}:latest || true"
                    echo 'Old Docker image removed.'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'GITTOKEN', variable: 'GIT_TOKEN')]) {
                        sh 'docker build --no-cache --build-arg GIT_TOKEN="$GIT_TOKEN" -t ${IMAGE_NAME}:latest .'
                    }
                }
            }
        }

        stage('Stop and Remove Old Container') {
            steps {
                script {
                    echo 'Stopping and removing old container...'
                    def containerExists = sh(
                        script: "docker ps -aq --filter 'name=${CONTAINER_NAME}'",
                        returnStdout: true
                    ).trim()

                    if (containerExists) {
                        sh "docker stop ${containerExists}"
                        sh "docker rm ${containerExists}"
                        echo "Old container stopped and removed."
                    } else {
                        echo "No old container found, skipping stop and remove."
                    }
                }
            }
        }

        stage('Deploy Container') {
            steps {
                script {
                    echo 'Deploying container...'
                    sh "docker run -d -p ${PORT} --name ${CONTAINER_NAME} --memory=2g --memory-swap=2g --cpus=1 ${IMAGE_NAME}:latest"
                    echo 'Container deployed successfully!'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            script {
                echo 'Pipeline failed. Attempting rollback...'

                // Stop & Remove existing container if exists
                def containerExists = sh(
                    script: "docker ps -aq --filter 'name=${CONTAINER_NAME}'",
                    returnStdout: true
                ).trim()

                if (containerExists) {
                    echo "Stopping and removing existing container..."
                    sh "docker stop ${containerExists}"
                    sh "docker rm ${containerExists}"
                    echo "Existing container removed."
                }

                // Find latest backup image
                def latestBackup = sh(
                    script: "docker images --filter=reference='${IMAGE_NAME}-backup:*' --format '{{.Repository}}:{{.Tag}}' | sort | tail -n 1",
                    returnStdout: true
                ).trim()

                if (latestBackup) {
                    echo "Found backup image: ${latestBackup}, deploying..."
                    sh "docker run -d -p ${PORT} --name ${CONTAINER_NAME} ${latestBackup}"
                    echo "Rollback completed using backup image: ${latestBackup}"
                } else {
                    echo "No backup image found. Rollback cannot be completed."
                }
            }
        }
    }
}
