pipeline {
    agent any
    environment {
        DEPLOY_STATE_DIR = '/wms/deploy-state'
        REPO_NAME = 'prime-wms-erp-core'      
        IMAGE_NAME = 'wms-erp-core'
        PORT = '9115:9115' 
        CONTAINER_NAME = 'wms-erp-core-container'
        TARGET_BRANCH = 'Demo'
        REMOTE_USER = 'ec2-user'
        REMOTE_HOST = '18.139.159.17'
        SSH_KEY_PATH = '/home/ec2-user/key/Demo-Linux.pem'
        VAULT_PATH = 'JenkinsWMS/jenkins.DemoWMS'
        ENV_FILE_KEY = 'Demo.env.erp' 
        DOCKERFILEPATH = 'Deployment.config/Demo/Dockerfile'
    }
    parameters {
        choice(name: 'MIGRATE', choices: ['auto', 'force', 'skip'], description: 'auto = รันเมื่อ migrations/ หรือ cron_config/ เปลี่ยน (deploy ครั้งแรกรันเสมอ), force = รันแน่นอน, skip = ไม่รัน')
        choice(name: 'SEED', choices: ['auto', 'force', 'skip'], description: 'auto = รันเมื่อ seeds/<SEED_SET>/ หรือ cron_config/seeds/<SEED_SET>/ เปลี่ยน (deploy ครั้งแรกรันเสมอ), force = รันแน่นอน, skip = ไม่รัน')
        string(name: 'SEED_SET', defaultValue: '', description: 'folder ใต้ seeds/ ที่จะรัน (ว่าง = TARGET_BRANCH)')
    }
    stages {
        stage('Check SSH Key Access and User') {
            steps {
                script {
                    echo "Check current Jenkins user"
                    sh 'whoami'

                    echo "Check SSH key file permission and existence"
                    sh "ls -l ${SSH_KEY_PATH} || echo 'SSH key file not found or no permission'"

                    echo "Test reading SSH key file content (first line only)"
                    sh "head -1 ${SSH_KEY_PATH} || echo 'Cannot read SSH key file'"

                    echo "Test ssh command dry run (no login)"
                    sh "ssh -o BatchMode=yes -o ConnectTimeout=5 -i ${SSH_KEY_PATH} ${REMOTE_USER}@${REMOTE_HOST} 'echo SSH connection test successful' || echo 'SSH connection test failed'"
                }
            }
        }
        stage('SSH to Remote Server') {
            steps {
                script {
                    echo "Testing SSH connection to ${REMOTE_USER}@${REMOTE_HOST}"
                    sh "ssh -o StrictHostKeyChecking=no -i ${SSH_KEY_PATH} ${REMOTE_USER}@${REMOTE_HOST} 'pwd'"
                }
            }
        }
stage('Clone Repository') {
    steps {
        script {
            echo "Cloning repository branch: ${TARGET_BRANCH} on remote server..."

            withCredentials([
                string(credentialsId: 'GITTOKEN', variable: 'GIT_TOKEN')
            ]) {
                sh '''
                    set +x
                    set -e

                    ssh -o StrictHostKeyChecking=no \
                        -i "$SSH_KEY_PATH" \
                        "$REMOTE_USER@$REMOTE_HOST" \
                        "
                        if [ -d '$REPO_NAME/.git' ]; then
                            cd '$REPO_NAME'
                            git fetch origin '$TARGET_BRANCH'
                            git checkout '$TARGET_BRANCH'
                            git reset --hard 'origin/$TARGET_BRANCH'
                        else
                            git clone --depth 1 \
                                -b '$TARGET_BRANCH' \
                                'https://x-access-token:${GIT_TOKEN}@github.com/prime-solution-dev/${REPO_NAME}.git' \
                                '$REPO_NAME'
                        fi
                        "
                '''
            }

            echo 'Repository cloned/updated successfully!'
        }
    }
}
        stage('Check GitHub Changes') {
            steps {
                script {
                    def migrateMode = params.MIGRATE ?: 'auto'
                    def seedMode = params.SEED ?: 'auto'
                    env.SEED_DIR = params.SEED_SET?.trim() ? params.SEED_SET.trim() : env.TARGET_BRANCH
                    if (!(env.SEED_DIR ==~ /[A-Za-z0-9_-]+/)) {
                        error("SEED_SET must be a folder name under seeds/ (letters, digits, _ or -): ${env.SEED_DIR}")
                    }
                    if (env.SEED_DIR in ['schema', 'dev']) {
                        error("SEED_SET must not be '${env.SEED_DIR}' (reserved folder under seeds/)")
                    }
                    env.STATE_KEY = env.JOB_NAME.replaceAll('[^A-Za-z0-9_.-]', '_')
                    echo 'Comparing the fetched GitHub commit with the last deployed commit...'
                    def changeFlags = sh(
                        script: '''
                            set -eu
                            ssh -o StrictHostKeyChecking=no -i "$SSH_KEY_PATH" \
                                "$REMOTE_USER@$REMOTE_HOST" \
                                bash -s -- "$REPO_NAME" "$DEPLOY_STATE_DIR" "$SEED_DIR" "$STATE_KEY" <<'REMOTE_SCRIPT'
set -eu
repo_name=$1
state_dir=$2
seed_dir=$3
state_key=$4
cd "$repo_name"
current=$(git rev-parse HEAD)
state_file="$state_dir/$state_key.commit"
if [ ! -s "$state_file" ]; then
    echo 'No previous deployed commit; treating migrations and seeds as changed.' >&2
    echo 'true true'
else
    previous=$(cat "$state_file")
    if ! git cat-file -e "$previous^{commit}" 2>/dev/null; then
        git fetch --depth 1 origin "$previous" >&2 || { echo 'previous commit unavailable; treating as changed' >&2; echo 'true true'; exit 0; }
    fi
    changed=$(git diff --name-only "$previous" "$current" -- migrations/ cron_config/ "seeds/$seed_dir/")
    migrations=false
    seeds=false
    printf '%s\n' "$changed" | grep -Eq '^(migrations/|cron_config/[^/]+$)' && migrations=true || true
    printf '%s\n' "$changed" | grep -Eq "^(cron_config/)?seeds/$seed_dir/" && seeds=true || true
    echo "$migrations $seeds"
fi
REMOTE_SCRIPT
                        ''',
                        returnStdout: true
                    ).trim()
                    def flags = changeFlags.tokenize()
                    if (flags.size() != 2 || !(flags[0] in ['true', 'false']) || !(flags[1] in ['true', 'false'])) {
                        error("Could not determine migration/seed changes from GitHub: ${changeFlags}")
                    }
                    if (params.SEED_SET?.trim() && seedMode == 'auto') {
                        flags[1] = 'true'
                    }
                    env.RECORD_COMMIT = (!((migrateMode == 'skip' && flags[0] == 'true') || (seedMode == 'skip' && flags[1] == 'true'))).toString()
                    if (env.RECORD_COMMIT == 'false') {
                        echo 'WARNING: changes skipped; deployed commit not recorded so next auto run will apply them'
                    }
                    env.RUN_MIGRATE = (migrateMode == 'force' || (migrateMode == 'auto' && flags[0] == 'true')).toString()
                    env.RUN_SEED = (seedMode == 'force' || (seedMode == 'auto' && flags[1] == 'true')).toString()
                    echo "MIGRATE=${migrateMode} changed=${flags[0]} -> run=${env.RUN_MIGRATE}; SEED=${seedMode} set=${env.SEED_DIR} changed=${flags[1]} -> run=${env.RUN_SEED}"
                }
            }
        }
        stage('Ensure Go Migration Image') {
            when {
                expression { env.RUN_MIGRATE == 'true' || env.RUN_SEED == 'true' }
            }
            steps {
                script {
                    sh '''
                        set -eu
                        ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" bash -s <<'REMOTE_IMAGE_CHECK'
set -eu
if docker image inspect golang:1.25 >/dev/null 2>&1; then
    echo 'Found golang:1.25 locally; skipping pull.'
else
    docker pull golang:1.25
fi
REMOTE_IMAGE_CHECK
                    '''
                }
            }
        }
        stage('Check Workspace') {
            steps {
                script {
                    sh "ssh -i ${SSH_KEY_PATH} ${REMOTE_USER}@${REMOTE_HOST} 'pwd && ls -la ${REPO_NAME}'"
                }
            }
        }
        stage('Backup Current Image') {
            steps {
                script {
                    def timestamp = new Date().format("yyyyMMdd-HHmmss", TimeZone.getTimeZone('UTC'))
                    def backupImageName = "${IMAGE_NAME}-backup:${timestamp}"
                    def exportPath = "/wms/backup_wms/${IMAGE_NAME}-backup-${timestamp}.tar"

                    echo 'Backing up current image on remote server...'
                    sh """ssh -i ${SSH_KEY_PATH} ${REMOTE_USER}@${REMOTE_HOST} \\
                    "sourceImage=\\\$(docker images --filter=reference='${IMAGE_NAME}:latest' -q); \\
                    if [ -n \\\"\\\$sourceImage\\\" ]; then \\
                        docker tag ${IMAGE_NAME}:latest ${backupImageName}; \\
                        docker save -o ${exportPath} ${backupImageName}; \\
                        echo 'Backup created and exported to ${exportPath}'; \\
                    else \\
                        echo 'No source image found, skipping backup.'; \\
                    fi" """
                    echo 'Cleaning up old backups on remote server...'
                    sh """ssh -i ${SSH_KEY_PATH} ${REMOTE_USER}@${REMOTE_HOST} \\
                    "docker images --filter=reference='${IMAGE_NAME}-backup:*' --format '{{.Repository}}:{{.Tag}}' | sort | head -n -5 | xargs -r docker rmi -f" """
                }
            }
        }
        stage('Remove Old Docker Image') {
            steps {
                script {
                    echo 'Removing old Docker image on remote server...'
                    sh """ssh -i ${SSH_KEY_PATH} ${REMOTE_USER}@${REMOTE_HOST} docker rmi -f ${IMAGE_NAME}:latest || true"""
                }
            }
        }
stage('Fetch .env from Vault (Remote)') {
    steps {
        script {
            withVault([
                vaultSecrets: [
                    [
                        path: "${VAULT_PATH}",
                        engineVersion: 2,
                        secretValues: [
                            [
                                envVar: 'AUTHEN_ENV',
                                vaultKey: "${ENV_FILE_KEY}"
                            ]
                        ]
                    ]
                ]
            ]) {
                sh '''
                    set +x

                    printf '%s\\n' "$AUTHEN_ENV" |
                    ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" \
                    "cd '$REPO_NAME' && \
                     mkdir -p cmd && \
                     cat > cmd/.env && \
                     chmod 600 cmd/.env"
                '''
            }
        }
    }
}
stage('Run Database Migrations') {
    when { expression { env.RUN_MIGRATE == 'true' } }
    steps {
        script {
            echo 'Running database migrations (schema + cron-config) before replacing the container...'
            withVault([vaultSecrets: [[
                path: "${VAULT_PATH}",
                engineVersion: 2,
                secretValues: [[envVar: 'MIGRATION_ENV', vaultKey: "${ENV_FILE_KEY}"]]
            ]]]) {
                withCredentials([string(credentialsId: 'GITTOKEN', variable: 'GIT_TOKEN')]) {
                    sh '''
                        set +x
                        set -eu
                        printf '%s\n' "$MIGRATION_ENV" | ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" \
                            "cd '$REPO_NAME' && umask 077 && cat > .env && chmod 600 .env"
                        printf 'GIT_TOKEN=%s\n' "$GIT_TOKEN" | ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" \
                            "cd '$REPO_NAME' && umask 077 && cat > .migration-secrets && chmod 600 .migration-secrets"
                        ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" \
                            bash -s -- "$REPO_NAME" <<'REMOTE_TASK_SCRIPT'
set -eu
repo_name=$1
cd "$repo_name"
run_status=0
docker run --rm --network host --env-file .migration-secrets \
    -e 'GOPRIVATE=github.com/prime-solution-dev/*' \
    -v gomodcache:/go/pkg/mod -v gobuildcache:/root/.cache/go-build \
    -v "$PWD:/src" -w /src golang:1.25 sh -ec '
        set -eu
        umask 077
        printf "machine github.com\nlogin x-access-token\npassword %s\n" "$GIT_TOKEN" > /root/.netrc
        trap "rm -f /root/.netrc" EXIT
        go run ./cmd/migrate -command up
        go run ./cmd/migrate -set cron-config -command up
    ' || run_status=$?
rm -f .env .migration-secrets
exit "$run_status"
REMOTE_TASK_SCRIPT
                    '''
                }
            }
        }
    }
}
stage('Run Database Seeds') {
    when { expression { env.RUN_SEED == 'true' } }
    steps {
        script {
            echo "Running database seeds from seeds/${env.SEED_DIR}/ and cron_config/seeds/${env.SEED_DIR}/ before replacing the container..."
            withVault([vaultSecrets: [[
                path: "${VAULT_PATH}",
                engineVersion: 2,
                secretValues: [[envVar: 'SEED_ENV', vaultKey: "${ENV_FILE_KEY}"]]
            ]]]) {
                withCredentials([string(credentialsId: 'GITTOKEN', variable: 'GIT_TOKEN')]) {
                    sh '''
                        set +x
                        set -eu
                        printf '%s\n' "$SEED_ENV" | ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" \
                            "cd '$REPO_NAME' && umask 077 && cat > .env && chmod 600 .env"
                        printf 'GIT_TOKEN=%s\n' "$GIT_TOKEN" | ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" \
                            "cd '$REPO_NAME' && umask 077 && cat > .migration-secrets && chmod 600 .migration-secrets"
                        ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" \
                            bash -s -- "$REPO_NAME" "$SEED_DIR" <<'REMOTE_TASK_SCRIPT'
set -eu
repo_name=$1
seed_dir=$2
cd "$repo_name"
run_status=0
docker run --rm --network host --env-file .migration-secrets \
    -e 'GOPRIVATE=github.com/prime-solution-dev/*' \
    -v gomodcache:/go/pkg/mod -v gobuildcache:/root/.cache/go-build \
    -e SEED_DIR="$seed_dir" \
    -v "$PWD:/src" -w /src golang:1.25 sh -ec '
        set -eu
        umask 077
        printf "machine github.com\nlogin x-access-token\npassword %s\n" "$GIT_TOKEN" > /root/.netrc
        trap "rm -f /root/.netrc" EXIT
        go run ./cmd/migrate -set "$SEED_DIR" -command up
        if [ -d "seeds/$SEED_DIR" ]; then
    go run ./cmd/migrate -set "$SEED_DIR" -command up
else
    echo "Seed folder seeds/$SEED_DIR not found; skipping"
fi
    ' || run_status=$?
rm -f .env .migration-secrets
exit "$run_status"
REMOTE_TASK_SCRIPT
                    '''
                }
            }
        }
    }
}
stage('Build Docker Image') {
    steps {
        script {
            echo 'Building Docker image on remote server...'

            withCredentials([
                string(credentialsId: 'GITTOKEN', variable: 'GIT_TOKEN')
            ]) {
                sh """
                    ssh -o StrictHostKeyChecking=no -i '${SSH_KEY_PATH}' \
                    '${REMOTE_USER}@${REMOTE_HOST}' \
                    'cd ${REPO_NAME} && \
                    docker build --no-cache \
                    -f ${DOCKERFILEPATH} \
                    --build-arg GIT_TOKEN="${GIT_TOKEN}" \
                    -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
                """
            }
        }
    }
}

                stage('Stop and Remove Old Container') {
            steps {
                script {
                    echo 'Stopping and removing old container on remote server...'
                    sh """ssh -i ${SSH_KEY_PATH} ${REMOTE_USER}@${REMOTE_HOST} \\
                    "docker ps -aq --filter name=${CONTAINER_NAME} | xargs -r docker stop && docker ps -aq --filter name=${CONTAINER_NAME} | xargs -r docker rm" """
                }
            }
        }
stage('Deploy Container') {
    steps {
        script {
            echo 'Deploying container on remote server...'
            sh """
                ssh -i ${SSH_KEY_PATH} ${REMOTE_USER}@${REMOTE_HOST} '
                    mkdir -p /wms/${REPO_NAME}/downloads &&

                    docker run -d \
                        -p ${PORT} \
                        --cpus=1.0 \
                        --name ${CONTAINER_NAME} \
                        -m 4g \
                        --memory-swap 4g \
                        -v /wms/${REPO_NAME}/downloads:/app/downloads \
                        ${IMAGE_NAME}:${env.BUILD_NUMBER} &&
                    docker tag ${IMAGE_NAME}:${env.BUILD_NUMBER} ${IMAGE_NAME}:latest
                '
            """
        }
    }
}
stage('Verify Container') {
    steps {
        script {
            echo 'Checking the container started (server exits if a database is unreachable)...'
            sh '''
                set -eu
                ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" bash -s -- "$CONTAINER_NAME" <<'REMOTE_SCRIPT'
set -eu
name=$1
for i in $(seq 1 30); do
    if docker logs "$name" 2>&1 | grep -q 'Starting server on port'; then
        echo "container $name is up"
        exit 0
    fi
    [ "$(docker inspect -f '{{.State.Running}}' "$name")" = true ] || break
    sleep 2
done
echo "container $name failed to start:"
docker logs --tail 50 "$name" 2>&1
exit 1
REMOTE_SCRIPT
            '''
        }
    }
}
stage('Record Deployed Commit') {
    when { expression { env.RECORD_COMMIT == 'true' } }
    steps {
        script {
            sh '''
                set -eu
                ssh -i "$SSH_KEY_PATH" "$REMOTE_USER@$REMOTE_HOST" \
                    "set -eu; mkdir -p '$DEPLOY_STATE_DIR'; cd '$REPO_NAME'; git rev-parse HEAD > '$DEPLOY_STATE_DIR/$STATE_KEY.commit.tmp'; mv '$DEPLOY_STATE_DIR/$STATE_KEY.commit.tmp' '$DEPLOY_STATE_DIR/$STATE_KEY.commit'"
            '''
        }
    }
}

    stage('Clean Up Repository') {
        steps {
            script {
                echo 'Cleaning up cloned repository on remote...'

                sh '''
                    ssh -i "$SSH_KEY_PATH" \
                    "$REMOTE_USER@$REMOTE_HOST" \
                    bash -se -- "$REPO_NAME" <<'REMOTE_SCRIPT'

                    REPO_NAME="$1"

                    case "$REPO_NAME" in
                        ""|"/"|".")
                            echo "Unsafe repository path: $REPO_NAME"
                            exit 1
                            ;;
                    esac

                    rm -rf -- "$REPO_NAME"
REMOTE_SCRIPT
                '''
            }
        }
    }
}

post {
    success {
        echo 'Pipeline completed successfully!'
    }

    failure {
        script {
            echo 'Pipeline failed. Checking logs; automatic rollback is not configured.'

            sh(
                returnStatus: true,
                script: '''
                    ssh -i "$SSH_KEY_PATH" \
                    "$REMOTE_USER@$REMOTE_HOST" \
                    "docker ps -a \
                     --filter name='$CONTAINER_NAME' && \
                     docker logs \
                     --tail 100 \
                     '$CONTAINER_NAME' 2>/dev/null || true"
                '''
            )
        }
    }
}
}
